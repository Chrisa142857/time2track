# Machine roots read by paths.py. Copy to .env (untracked) and fill in.
# Everything else in the project is derived from these or from the repo location.
T2T_RAM_ROOT=/path/to/ram/user          # read-only: venv, data, shipped checkpoints
T2T_WORK_ROOT=/path/to/work/user        # scratch inputs outside the repo (e.g. emg2pose_work)
T2T_CNS_ROOT=/path/to/cns/user          # original CMR mesh store
T2T_PYTHON=/path/to/venv/bin/python     # the one project interpreter

# WHITELIST. Every top-level entry is ignored unless re-included below, so data,
# checkpoints and experiment outputs can never be committed by accident however
# the tree grows. Already-tracked files are unaffected by ignore rules.
#
# experiments/, docs/ and superseded/ are local records with machine paths, so
# they are deliberately NOT re-included.
/*
!/.gitignore
!/.gitattributes
!/.python-version
!/README.md
!/LICENSE
!/pyproject.toml
!/uv.lock
!/requirements.txt
!/*.py
!/*.sh
!/*.ipynb
!/src/
!/libs/
!/example_ecg_gif/
!/data_prep/
!/reproduce/

# Inside re-included directories: caches and heavy or generated files stay out.
__pycache__/
.ipynb_checkpoints/
*.pyc
*.pt
*.pth
*.safetensors
*.npy
*.npz
*.svg
*.png
*.csv
outputs/
checkpoints/
results/
src/data_generation/data/
data_generation/
# sEMG diffusion and regressor code that no result of the paper uses, and an internal table script
/src/*emg*
/src/configs/*emg*
/src/dataset/emg2pose_dataset.py
/src/model/emg_joint*
/*emg*.sh
gen_whole_heart_table.py
# local helper, not part of the release
/paths.py
